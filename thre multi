import java.io.*;
import java.net.*;
import java.util.Scanner;

/**
 * Client: Sends array and receives sorted array, min, and max
 */
class ClientCombined {
    public static void main(String[] args) {
        Socket socket = null;

        try {
            socket = new Socket("127.0.0.1", 8080); // connect to server
            System.out.println("Connected to server!");

            ObjectOutputStream toServer = new ObjectOutputStream(
                    socket.getOutputStream()); // send data

            ObjectInputStream fromServer = new ObjectInputStream(
                    socket.getInputStream()); // receive data

            Scanner scanner = new Scanner(System.in);

            // get array size
            System.out.print("Enter array size: ");
            int size = scanner.nextInt();

            int[] arr = new int[size];

            // get elements
            System.out.println("Enter elements:");
            for (int i = 0; i < size; i++) {
                arr[i] = scanner.nextInt();
            }

            // display original array
            System.out.print("Original array: ");
            for (int num : arr) {
                System.out.print(num + " ");
            }
            System.out.println();

            // SEND DATA

            toServer.writeInt(size); // send size

            for (int i = 0; i < size; i++) {
                toServer.writeInt(arr[i]); // send elements
            }

            toServer.flush();

            System.out.println("Data sent to server...");

            // RECEIVE RESULTS

            int newSize = fromServer.readInt(); // receive size

            int[] sorted = new int[newSize];

            for (int i = 0; i < newSize; i++) {
                sorted[i] = fromServer.readInt(); // receive sorted array
            }

            int min = fromServer.readInt(); // receive min
            int max = fromServer.readInt(); // receive max

            // DISPLAY RESULTS

            System.out.print("Sorted array: ");
            for (int num : sorted) {
                System.out.print(num + " ");
            }
            System.out.println();

            System.out.println("Minimum: " + min);
            System.out.println("Maximum: " + max);

            socket.close(); // close connection

        } catch (IOException e) {
            System.err.println("Error: " + e.getMessage());
        }
    }
}
