import java.io.*;
import java.net.*;
import java.util.Arrays; // for sorting

/**
 * Server: Receives array, sorts it, finds min and max
 */
class ServerCombined {
    private static final int PORT = 8080; // server port

    public static void main(String[] args) {
        ServerSocket serverSocket = null;

        try {
            serverSocket = new ServerSocket(PORT); // create server
            System.out.println("Server started...");
            System.out.println("Waiting for clients...");

            while (true) { // run forever
                Socket clientSocket = serverSocket.accept(); // accept client
                System.out.println("Client connected: " + clientSocket.getInetAddress());

                // handle client in new thread
                new Thread(() -> handleClient(clientSocket)).start();
            }

        } catch (IOException e) {
            System.err.println("Server error: " + e.getMessage());
        }
    }

    private static void handleClient(Socket socket) {
        try {
            ObjectInputStream fromClient = new ObjectInputStream(
                    socket.getInputStream()); // receive data

            ObjectOutputStream toClient = new ObjectOutputStream(
                    socket.getOutputStream()); // send data

            int size = fromClient.readInt(); // read array size
            System.out.println("Receiving array of size: " + size);

            int[] arr = new int[size]; // create array

            for (int i = 0; i < size; i++) {
                arr[i] = fromClient.readInt(); // read elements
            }

            // print received array
            System.out.print("Received array: ");
            for (int num : arr) {
                System.out.print(num + " ");
            }
            System.out.println();

            // PROCESS 1: sort array
            Arrays.sort(arr); // sort ascending

            // PROCESS 2: find min and max
            int min = arr[0]; // first element (after sorting)
            int max = arr[arr.length - 1]; // last element

            System.out.println("Min: " + min);
            System.out.println("Max: " + max);

            // SEND RESULTS

            // send size of sorted array
            toClient.writeInt(size);

            // send sorted array
            for (int i = 0; i < size; i++) {
                toClient.writeInt(arr[i]);
            }

            // send min and max
            toClient.writeInt(min);
            toClient.writeInt(max);

            toClient.flush(); // ensure data is sent

            socket.close(); // close connection
            System.out.println("Client disconnected\n");

        } catch (IOException e) {
            System.err.println("Error handling client: " + e.getMessage());
        }
    }
}

