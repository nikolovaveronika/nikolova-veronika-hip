import java.io.*; 
// imports file classes (File, FileWriter, FileReader, BufferedReader, IOException)

import java.util.Scanner; 
// imports Scanner for reading user input from keyboard

public class TodoListManager { 
    // main class for the To-Do application

    public static void main(String[] args) { 
        // program starts here

        Scanner scanner = new Scanner(System.in); 
        // creates scanner to read user input

        String fileName = "todo.txt"; 
        // file where tasks will be stored

        while (true) { 
            // infinite loop so program keeps running until user types exit

            System.out.print("Enter command: "); 
            // prompt user

            String input = scanner.nextLine().trim(); 
            // reads full command and removes extra spaces

            if (input.equalsIgnoreCase("exit")) { 
                // if user types exit (any case), stop program
                break;
            }

            String[] parts = input.split(" ", 2); 
            // splits input into command and optional task (max 2 parts)

            String command = parts[0].toLowerCase(); 
            // first word is the command (add/view/etc.)

            switch (command) { 
                // checks which command user typed

                case "add": 
                    // ADD TASK COMMAND

                    if (parts.length < 2) { 
                        // checks if task text is missing
                        System.out.println("Error: No task provided"); 
                        break;
                    }

                    try (FileWriter writer = new FileWriter(fileName, true)) { 
                        // opens file in append mode (true = do not overwrite)

                        writer.write(parts[1] + System.lineSeparator()); 
                        // writes task into file with new line

                        System.out.println("Task added"); 
                        // feedback to user

                    } catch (IOException e) { 
                        // handles file writing errors
                        System.out.println("Error: Cannot write to file");
                    }

                    break;

                case "view": 
                    // VIEW TASKS COMMAND

                    File file = new File(fileName); 
                    // creates file object to check if file exists

                    if (!file.exists() || file.length() == 0) { 
                        // checks if file is missing or empty
                        System.out.println("No tasks in the list");
                        break;
                    }

                    System.out.println("To-Do List:"); 
                    // header output

                    try (BufferedReader reader = new BufferedReader(new FileReader(file))) { 
                        // opens file for reading line by line

                        String line; 
                        // stores each line from file

                        int number = 1; 
                        // task counter for numbering

                        while ((line = reader.readLine()) != null) { 
                            // reads each line until end of file

                            System.out.println(number + ". " + line); 
                            // prints numbered task

                            number++; 
                            // increases counter
                        }

                    } catch (IOException e) { 
                        // handles reading errors
                        System.out.println("Error reading file");
                    }

                    break;

                default: 
                    // if command is not recognized
                    System.out.println("Unknown command");
            }
        }

        scanner.close(); 
        // closes scanner (good practice)
    }
}
