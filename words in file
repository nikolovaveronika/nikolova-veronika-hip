try {
    List<String> lines = Files.readAllLines(Paths.get("example.txt"));
    int wordCount = 0;

    for (String line : lines) {
        String[] words = line.trim().split("\\s+");
        wordCount += words.length;
    }

    System.out.println("Total words: " + wordCount);
} catch (IOException e) {
    e.printStackTrace();
}
